# ===========================================
# AUTHENTICATION (required)
# ===========================================
# Long random string used to sign session JWTs.
# Generate with: openssl rand -base64 32
# NOTE: required at RUNTIME in production. The build itself succeeds without
# it (validation is deferred to first request) — set it in Vercel env vars.
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# Base URL of this app (used in password-reset emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# AI PROVIDER (required for symptom analysis + chat)
# ===========================================
GROQ_API_KEY="your-groq-api-key"

# ===========================================
# DATABASE (optional - defaults to local SQLite)
# ===========================================
# Leave empty to use a local file at ./data/medassist.db
# For production on Vercel, set this to a Turso connection string:
#   DATABASE_URL="libsql://your-database.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-auth-token"
# DATABASE_URL=""
# DATABASE_AUTH_TOKEN=""
# DATABASE_FILE="./data/medassist.db"

# ===========================================
# PROXY / MAIL (optional)
# ===========================================
# Set TRUST_PROXY=1 when running behind a trusted reverse proxy (Vercel,
# nginx, …) so per-IP rate limiting reads the real client IP.
# TRUST_PROXY="1"

# Resend (https://resend.com) — sends password-reset emails in production.
# Without it, reset links are logged to the server console (dev only).
# RESEND_API_KEY="re_..."
# MAIL_FROM="MedAssist <noreply@yourdomain.com>"
